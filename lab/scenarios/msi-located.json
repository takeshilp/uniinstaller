{ "about": "Per-machine x64 MSI with InstallLocation; afterwards the app writes a log, settings, FirstRun values and a tray Run value msiexec does not know about.",
  "install": ["labmsi-x64.msi"],
  "after_install": [
    { "file": "{PF}\\Lab Vendor\\Lab Msi\\logs\\app.log" },
    { "file": "{APPDATA}\\Lab Vendor\\Lab Msi\\settings.ini" },
    { "regval": "hkcu64:Software\\Lab Vendor\\Lab Msi|FirstRun", "data": "1" },
    { "regval": "hklm64:SOFTWARE\\Lab Vendor\\Lab Msi|FirstRun", "data": "1" },
    { "regval": "hkcu64:Software\\Microsoft\\Windows\\CurrentVersion\\Run|LabMsiTray", "data": "\"{PF}\\Lab Vendor\\Lab Msi\\labmsi.exe\" /tray" } ],
  "target": "Lab Msi", "select": "unblocked",
  "owned": ["{PF}\\Lab Vendor", "{APPDATA}\\Lab Vendor", "{COMMONPROGRAMS}\\Lab Msi.lnk",
    "key:hkcu64:software\\lab vendor", "key:hklm64:software\\lab vendor",
    "value:hkcu64:software\\microsoft\\windows\\currentversion\\run|labmsitray", "value:hklm64:software\\microsoft\\windows\\currentversion\\run|labmsi", "key:hklm64:software\\microsoft\\windows\\currentversion\\app paths\\labmsi.exe",
    "key:hklm64:software\\microsoft\\windows\\currentversion\\uninstall\\{6c1a0b52-3d4e-4f60-9a71-0b2c3d4e5f01}"],
  "userdoc": [], "control": [], "gap": [] }
