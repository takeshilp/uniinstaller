{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Uniinstaller",
  "version": "0.1.0",
  "identifier": "io.github.takeshilp.uniinstaller",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Uniinstaller",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "backgroundColor": "#111113"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI2QkQ2RTE0NEU5NUQyRUEKUldUcTBwVk9GRzY5SmdSQk9UYUFvaFNLNVJlWHc4eVRBMFNrc1BPSUlwcElWcktSbnAxYitTNnoK",
      "endpoints": [
        "https://github.com/takeshilp/uniinstaller/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
